{
	"layer": "top",
	"modules-left": ["user", "hyprland/workspaces", "hyprland/window"],
	"modules-center": ["clock"],
	"modules-right": ["network", "bluetooth", "pulseaudio", "tray", "custom/notifications", "custom/power"],

	"hyprland/workspaces": {
		"format": "{id}",
		"sort-by-number": true,
		"on-click": "activate",
		"on-scroll-up": "prev",
		"on-scroll-down": "next"
	},

	"pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "{icon} {volume}%",
		"format-muted": "{icon} muted",
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"format-icons": {
			"default": ["", "", ""]
		}
	},

	"network": {
		"tooltip": false,
		"format-wifi": "󰤨 {essid}",
		"format-ethernet": "󰈀 {ifname}",
		"format-disconnected": "󰤭",
	"on-click": "kitty --class floating -e nmtui"
	},

	"tray": {
		"icon-size": 16,
		"spacing": 8
	},

	"clock": {
		"format": "{:%H:%M %d.%m.%y}",
		"tooltip-format": "{:%A %d %B %Y}"
	},

	"cpu": {
		"interval": 15,
		"format": "󰍛 {}%"
	},

	"memory": {
		"interval": 30,
		"format": "󰑭 {}%"
	},

	"bluetooth": {
		"format": "{status}",
		"format-on": "󰂯 {device_alias}",
		"format-off": "󰂲",
		"format-disabled": "󰂲",
		"on-click": "blueman-manager"
	},

	"custom/power": {
		"format": "󰐥",
		"on-click": "$HOME/.config/rofi/power-menu.sh"
	},

	"user": {
		"format": " {user}",
		"interval": 60,
		"icon": false,
		"on-click": "rofi -show drun",
		"on-click-right": "killall rofi"
	},

	"custom/notifications": {
		"format": "󰂚 {text}",
		"return-type": "json",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t",
		"on-click-right": "swaync-client -C"
	},

	"hyprland/window": {
		"max-length": 200,
		"separate-outputs": true
	}
}
